rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Server-only fields on the user document. These must never be SET to a
    // new value directly from the client SDK — they are mutated exclusively
    // by the backend (Admin SDK) via creditLedger.ts / admin.ts / brain.ts,
    // which bypass these rules entirely. Listing them here blocks the client-SDK
    // write path for setting them.
    //
    // This uses an allowlist-by-exclusion approach: all fields listed here are
    // server-owned. Any new server-owned field MUST be added here; otherwise a
    // signed-in client can write it directly via the client SDK.
    function touchesProtectedUserFields() {
      let protectedFields = [
        // Financial & plan state
        'creditBalance', 'plan', 'subscriptionStatus', 'guestInvitationId',
        // Ban state
        'banned', 'bannedReason', 'bannedAt', 'bannedBy',
        // Auto-refill config
        'autoRefill', 'autoRefillCheckoutUrl', 'autoRefillTriggeredAt',
        // Email lifecycle / "send once" flags — clients must not reset these
        // or they could re-trigger transactional emails at will.
        'welcomeEmailSent', 'firstSessionEmailSent',
        'lowCreditEmailSentAt', 'zeroCreditsEmailSentAt',
        'lastSessionAt', 'reengagementEmailSentAt'
      ];
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields);
    }

    // Users can read their own profile. Writes are allowed only for
    // non-financial, non-lifecycle fields (displayName, defaultSettings,
    // notification preferences, etc.) — the fields listed in
    // touchesProtectedUserFields() can only change via the Admin SDK.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny([
                         'creditBalance', 'plan', 'subscriptionStatus', 'guestInvitationId',
                         'banned', 'bannedReason', 'bannedAt', 'bannedBy',
                         'autoRefill', 'autoRefillCheckoutUrl', 'autoRefillTriggeredAt',
                         'welcomeEmailSent', 'firstSessionEmailSent',
                         'lowCreditEmailSentAt', 'zeroCreditsEmailSentAt',
                         'lastSessionAt', 'reengagementEmailSentAt'
                       ]);
      allow update: if request.auth != null && request.auth.uid == userId
                    && !touchesProtectedUserFields();
    }

    function trialAllowsData() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return !('guestInvitationId' in profile) || profile.guestInvitationId == null || activeInvitation(profile.guestInvitationId);
    }
    function activeInvitation(id) {
      let invitation = get(/databases/$(database)/documents/guest_invitations/$(id)).data;
      return invitation.claimedBy == request.auth.uid && invitation.revoked == false && invitation.expiresAt > request.time;
    }

    // Sessions: owner-only reads; writes through the server. Shared-session access is handled
    // server-side via the Admin SDK (report.ts / sessions.ts), which bypasses
    // these rules entirely — no broad client-SDK read needed here.
    // NOTE: The session rule uses resource.data.userId which is undefined on
    // CREATE (the document doesn't exist yet) — this correctly denies client-side
    // creates, since all sessions are written by the Admin SDK via brain.ts.
    match /sessions/{sessionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId && trialAllowsData()
        && (request.auth.token.get('admin', false) == true || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('plan', 'free') == 'pro')
        && resource.data.get('memorySaved', true) != false;
      // Persisted transcript, configuration and billing fields are server-owned.
      allow write: if false;
    }

    // Feedback: any signed-in user (or guest, where userId is null) may
    // create a feedback entry; nobody can read, update, or delete via the
    // client SDK. submitFeedback() in feedbackService.ts relies on create
    // succeeding — without this block all feedback submissions silently fail.
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.userId == null
                    || (request.auth != null && request.auth.uid == request.resource.data.userId);
      allow read, update, delete: if false;
    }

    // Admin-only collections
    match /admin/{document=**} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // Everything else (config/*, credit_transactions/*, payment_events/*,
    // templates/*, system_config/*, guest_sessions/*, api_logs/*,
    // email_templates/*) is written and read exclusively by the backend via
    // the Firebase Admin SDK, which bypasses these rules entirely.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
