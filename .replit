modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "gh-brain-pdf-export-tests"

[[workflows.workflow]]
name = "gh-brain-pdf-export-tests"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/gh-brain && VITEST=true NODE_ENV=test pnpm test && PLAYWRIGHT_BASE_URL=\"https://$REPLIT_DEV_DOMAIN\" PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=$(which chromium) npx playwright test e2e/pdf-export.spec.ts --config playwright.config.ts"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8031
externalPort = 3000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 6000

[[ports]]
localPort = 8372
externalPort = 5173

[[ports]]
localPort = 8408
externalPort = 3003

[[ports]]
localPort = 8582
externalPort = 3002

[[ports]]
localPort = 8842
externalPort = 5000

[[ports]]
localPort = 8976
externalPort = 4200

[[ports]]
localPort = 18396
externalPort = 3001

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
# Credentials belong in the environment's secret store, never in this file.
# Production credentials are supplied by GitHub Actions; Firebase uses keyless identity.
VITE_FIREBASE_AUTH_DOMAIN = "litigant-ai.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID = "litigant-ai"
VITE_FIREBASE_STORAGE_BUCKET = "litigant-ai.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID = "781960492360"
VITE_FIREBASE_APP_ID = "1:781960492360:web:d735854efafcee8728ef7d"
SQUARE_APPLICATION_ID = "sq0idp-yOyVWVGhop7Pycv56c7XtA"
SQUARE_LOCATION_ID = "LJPE1062H7MBN"
SQUARE_ENVIRONMENT = "production"
APP_DOMAIN = "litigant-ai.com"
WIF_PROVIDER = "projects/781960492360/locations/global/workloadIdentityPools/github-actions/providers/github"
WIF_SERVICE_ACCOUNT = "litigant-ai@appspot.gserviceaccount.com"
